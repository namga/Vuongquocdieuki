{
  "name": "vuong-quoc-dieu-ki",
  "version": "1.0.0",
  "private": true,
  "description": "Vương Quốc Diệu Kì – game giáo dục tiếng Việt cho trẻ 5-10 tuổi, PWA và Capacitor Android/iOS",
  "scripts": {
    "start": "npx http-server www -p 8080",
    "cap:sync": "npm run build:web && cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "cap:android:icon": "node scripts/apply-android-icon.cjs",
    "build:web": "esbuild www/app.js --bundle --platform=browser --format=esm --outfile=www/app.bundle.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capacitor-community/text-to-speech": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "http-server": "^14.1.1",
    "esbuild": "^0.25.0"
  }
}
